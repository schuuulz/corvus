{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Corvus",
  "version": "0.5.0",
  "identifier": "com.corvus.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Corvus",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/schuuulz/corvus/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdGMjdGRjU5MUU4QjEzNTUKUldSVkU0c2VXZjhuZjM0Nko5WGs4NVZ3VUk2RXYwVmZDVjd1eEpLcllSWjZZaVBEM2hoaGNEUzQK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
